BEGIN HEADER
   CharacterSet "UTF-8"
   ExportingTool "IBM InfoSphere DataStage Export"
   ToolVersion "8"
   ServerName "DSSRV-ACT01"
   ToolInstanceID "ACTUARIAT"
   MDISVersion "1.0"
   Date "2025-11-03"
   Time "02.20.11"
   ServerVersion "11.7"
END HEADER
BEGIN DSJOB
   Identifier "j_primes_mensuelles"
   DateModified "2024-06-12"
   TimeModified "10.02.11"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "j_primes_mensuelles"
      Description "Primes émises par mois d'émission, produit et segment client (hors polices annulées)"
      JobType "3"
      JobVersion "56.0.0"
      BEGIN DSSUBRECORD
         Name "P_DATE_TRAITEMENT"
         Prompt "Date de traitement"
         Default "2026-06-30"
         ParamType "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "P_SCHEMA_DWH"
         Prompt "Schéma de l'entrepôt"
         Default "DWH"
         ParamType "0"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Readonly "0"
      Name "ORA_POLICES"
      StageType "OracleConnectorPX"
      OutputPins "V0S1P1"
      BEGIN DSSUBRECORD
         Name "SelectStatement"
         Value "SELECT POLICE_ID, CLIENT_ID, PRODUIT, DATE_DEBUT, PRIME_ANNUELLE, STATUT FROM #P_SCHEMA_DWH#.POLICES_COURANTES WHERE STATUT <> 'ANNULEE'"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "ArraySize"
         Value "2000"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomOutput"
      Name "lnk_polices"
      Partner "V0S3|V0S3P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CCustomStage"
      Readonly "0"
      Name "ORA_CLIENTS"
      StageType "OracleConnectorPX"
      OutputPins "V0S2P1"
      BEGIN DSSUBRECORD
         Name "SelectStatement"
         Value "SELECT CLIENT_ID, SEGMENT FROM #P_SCHEMA_DWH#.CLIENTS_COURANTS"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CCustomOutput"
      Name "lnk_clients_ref"
      Partner "V0S3|V0S3P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CCustomStage"
      Readonly "0"
      Name "LKP_SEGMENT"
      StageType "PxLookup"
      InputPins "V0S3P1|V0S3P2"
      OutputPins "V0S3P3"
      BEGIN DSSUBRECORD
         Name "LookupKey"
         Value "CLIENT_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "LookupFailure"
         Value "Continue"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "Partitioning"
         Value "Entire"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P3"
      OLEType "CCustomOutput"
      Name "lnk_polices_segment"
      Partner "V0S4|V0S4P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4"
      OLEType "CTransformerStage"
      Readonly "0"
      Name "TRF_DERIVATIONS"
      StageType "CTransformerStage"
      InputPins "V0S4P1"
      OutputPins "V0S4P2"
      BEGIN DSSUBRECORD
         Name "StageVar_EstNouveauProduit"
         Derivation "If lnk_polices_segment.PRODUIT <> sv_ProduitPrecedent Then 1 Else 0"
         Kind "StageVariable"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "MOIS_EMISSION"
         Derivation "DateToString(lnk_polices_segment.DATE_DEBUT, \"%yyyy%mm\")"
         Kind "Column"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRODUIT"
         Derivation "Trim(lnk_polices_segment.PRODUIT)"
         Kind "Column"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "SEGMENT"
         Derivation "If IsNull(lnk_polices_segment.SEGMENT) Then \"INCONNU\" Else lnk_polices_segment.SEGMENT"
         Kind "Column"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRIME"
         Derivation "NullToZero(lnk_polices_segment.PRIME_ANNUELLE)"
         Kind "Column"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4P2"
      OLEType "CTrxOutput"
      Name "lnk_derive"
      Partner "V0S5|V0S5P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5"
      OLEType "CCustomStage"
      Readonly "0"
      Name "AGG_MOIS_PRODUIT_SEGMENT"
      StageType "PxAggregator"
      InputPins "V0S5P1"
      OutputPins "V0S5P2"
      BEGIN DSSUBRECORD
         Name "GroupingKeys"
         Value "MOIS_EMISSION, PRODUIT, SEGMENT"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "Aggregations"
         Value "NB_POLICES=Count(); PRIMES_EMISES=Sum(PRIME); PRIME_MOYENNE=Mean(PRIME)"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "Method"
         Value "Hash"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5P2"
      OLEType "CCustomOutput"
      Name "lnk_agrege"
      Partner "V0S6|V0S6P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S6"
      OLEType "CCustomStage"
      Readonly "0"
      Name "ORA_PRIMES_MENSUELLES"
      StageType "OracleConnectorPX"
      InputPins "V0S6P1"
      BEGIN DSSUBRECORD
         Name "TableName"
         Value "#P_SCHEMA_DWH#.PRIMES_MENSUELLES"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "WriteMode"
         Value "Upsert"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "UpsertKeys"
         Value "MOIS_EMISSION, PRODUIT, SEGMENT"
      END DSSUBRECORD
   END DSRECORD
END DSJOB
